{
  "id": "turtlequest.harvest_tree",
  "kind": "behavior",
  "description": "Tree harvesting v1: scan for nearby logs, approach the nearest candidate, cut the base log, fell the vertical trunk, record inventory evidence, and return home by breadcrumbs.",
  "params": {
    "radius": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 12
    },
    "pathBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32,
      "default": 12
    },
    "returnHome": {
      "type": "boolean",
      "default": true
    }
  },
  "steps": [
    { "action": "startBehavior" },
    {
      "action": "scanNearby",
      "arguments": {
        "radius": "$radius",
        "tag": "minecraft:logs",
        "blockContains": "_log",
        "maxMatches": 16
      }
    },
    {
      "action": "moveTowardRelative",
      "arguments": {
        "source": "lastScanNearest",
        "budget": "$pathBudget",
        "stopAdjacent": true
      }
    },
    {
      "action": "digRememberedTarget",
      "arguments": {
        "source": "lastScanNearest",
        "expectedTag": "minecraft:logs"
      }
    },
    {
      "action": "fellRememberedTree",
      "arguments": {
        "maxHeight": 12,
        "expectedTag": "minecraft:logs"
      }
    },
    { "action": "getInventory" },
    {
      "action": "returnHome",
      "arguments": {
        "mode": "breadcrumbs"
      }
    },
    {
      "action": "emitStatus",
      "arguments": {
        "stage": "full_tree_felled_returned"
      }
    },
    { "action": "completeObjective" }
  ],
  "successCriteria": {
    "completionArtifact": "turtlequest.objective_completed",
    "minimumScanNearbyReceipts": 1,
    "minimumApproachReceipts": 1,
    "minimumRememberedTargetDigReceipts": 1,
    "minimumFellRememberedTreeReceipts": 1,
    "minimumReturnHomeReceipts": 1,
    "stage": "full_tree_felled_returned"
  },
  "failureModes": [
    "no_scan_target",
    "path_budget_exhausted",
    "target_not_adjacent",
    "target_changed",
    "cc_tweaked_command_failed",
    "objective_not_satisfied"
  ]
}
