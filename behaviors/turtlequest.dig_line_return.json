{
  "id": "turtlequest.dig_line_return",
  "kind": "behavior",
  "description": "Dig a straight line, turn around, and return to the starting position while facing the direction of travel.",
  "params": {
    "length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "returnHome": {
      "type": "boolean",
      "default": true
    }
  },
  "steps": [
    { "action": "startBehavior" },
    {
      "repeat": {
        "count": "$length",
        "steps": [
          { "action": "inspect" },
          { "action": "dig" },
          { "action": "moveForward" }
        ]
      }
    },
    { "action": "turnRight" },
    { "action": "turnRight" },
    {
      "repeat": {
        "count": "$length",
        "steps": [
          { "action": "moveForward" }
        ]
      }
    },
    { "action": "completeObjective" }
  ],
  "successCriteria": {
    "finalPosition": "start",
    "completionArtifact": "turtlequest.objective_completed"
  },
  "failureModes": [
    "turtle_missing",
    "cc_tweaked_command_failed",
    "objective_not_satisfied"
  ]
}
