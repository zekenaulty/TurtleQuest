TURTLEQUEST_BRIDGE_URL=http://127.0.0.1:57421
TURTLEQUEST_USE_PLANNER_FOR_MESSAGES=true
TURTLEQUEST_PLANNER_MODE=agentica
TURTLEQUEST_PLANNER_FALLBACK_MODE=deterministic
TURTLEQUEST_PLANNER_REPAIR_ATTEMPTS=1
TURTLEQUEST_LLM_ENV_FILE=C:\Users\Zythis\source\repos\Agentica\.env
TURTLEQUEST_LLM_MODEL=gemini-2.5-flash

# Primary local Agentica planner host. This references Agentica and Agentica.Clients
# in-process from TurtleQuest without modifying the adjacent Agentica repo.
# The command must read TurtleAgenticaPlannerCommandRequest JSON from stdin
# and write TurtleCompiledPlan JSON to stdout.
AGENTICA_TURTLEQUEST_PLANNER_COMMAND=dotnet
AGENTICA_TURTLEQUEST_PLANNER_ARGS=run --project "C:\Users\Zythis\source\repos\Agentica.TurtleQuest\planner\Agentica.TurtleQuest.AgenticaPlanner\Agentica.TurtleQuest.AgenticaPlanner.csproj" --no-restore --
AGENTICA_TURTLEQUEST_PLANNER_CWD=C:\Users\Zythis\source\repos\Agentica.TurtleQuest
AGENTICA_TURTLEQUEST_PLANNER_TIMEOUT_SECONDS=240

TURTLEQUEST_AUTO_REPLAN_ON_BLOCKED=true
TURTLEQUEST_RUNTIME_REPLAN_MODE=agentica
TURTLEQUEST_RUNTIME_REPLAN_ATTEMPTS=1
